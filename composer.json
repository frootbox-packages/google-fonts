{
    "name": "frootbox/google-fonts",
    "description": "Google Fonts for the Frootbox CMS: search the catalog and import fonts once, so visitors load them from the own domain",
    "type": "frootbox-extension",
    "license": "MIT",
    "keywords": [
        "cms",
        "frootbox",
        "fonts",
        "google-fonts",
        "privacy"
    ],
    "require": {
        "php": ">=8.5",
        "frootbox/core": "^0.1",
        "frootbox/database": "^0.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "symfony/http-client": "^8.1"
    },
    "suggest": {
        "frootbox/backend": "The screen to search and import fonts"
    },
    "autoload": {
        "psr-4": {
            "Frootbox\\GoogleFonts\\": "src/",
            "Frootbox\\GoogleFonts\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Frootbox\\GoogleFonts\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
